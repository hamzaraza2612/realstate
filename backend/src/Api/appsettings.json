{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=realestate_erp;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "RealEstateErp",
    "Audience": "RealEstateErpClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "SuperAdmin": {
    "Email": "superadmin@realestate-erp.local",
    "Password": ""
  },
  "SeedDemoData": false,
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Real Estate ERP",
    "TimeoutSeconds": 15,
    "MaxRetries": 2
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "LocalPath": "./data/uploads",
    "MaxFileSizeMb": 25,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/webp",
      "text/plain",
      "text/csv",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/zip"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 300 },
      { "Endpoint": "post:/api/v1/auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/v1/auth/refresh", "Period": "1m", "Limit": 20 }
    ]
  },
  "AllowedHosts": "*"
}
