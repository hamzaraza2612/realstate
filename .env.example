# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=realestate_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# --- API ---
# Full Npgsql connection string used by the API container. Host must be the Postgres service
# name ("postgres"), not localhost — containers talk to each other by service name.
CONNECTION_STRING=Host=postgres;Port=5432;Database=realestate_erp;Username=postgres;Password=change-me-strong-password

# JWT signing secret — at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ISSUER=RealEstateErp
JWT_AUDIENCE=RealEstateErpClient
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Super Admin bootstrap account (created on first startup if it doesn't already exist).
SUPERADMIN_EMAIL=superadmin@yourcompany.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Set to true only for demo/sales environments — seeds a sample tenant with demo users.
SEED_DEMO_DATA=false

# Comma-separated list is not supported directly by ASP.NET Core array binding via env vars;
# set one origin per variable index, e.g. CORS_ALLOWED_ORIGINS__0, CORS_ALLOWED_ORIGINS__1.
# Set this to the public URL you'll access the app at (the Nginx origin), not an API host —
# the frontend talks to the API through the same origin via the reverse proxy.
CORS_ALLOWED_ORIGINS__0=http://localhost

ASPNETCORE_ENVIRONMENT=Production

# --- Frontend build ---
# Relative path (default) keeps frontend and API on the same origin, routed by the reverse-proxy
# Nginx — this is the right choice for the docker-compose topology and needs no host/IP. Only
# override if the frontend will call an API on a different origin than the one it's served from.
VITE_API_BASE_URL=/api/v1

# --- Reverse proxy ---
# Host port the whole application is reachable on (Nginx). Change if 80 is already taken.
HTTP_PORT=80
